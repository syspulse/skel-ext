  "name": "DetectorNews",
  "networkTags": [],
  "schema": {
    "$defs": {
      "Script": {
        "properties": {
          "type": {
            "description": "Script Type",
            "title": "Type",
            "type": "string",
            "enum": ["regexp","filter","sq","jq","js", "ai","regexp_score","sq_score","jq_score"],
            "default": "js"
          },
          "src": {
            "description": "Script Source",
            "title": "Source",
            "default": "",
            "type": "string"
          },
          "options": {
            "description": "Script Options",
            "title": "Options",
            "default": "",
            "type": "string"
          }
        },
        "required": ["type"],
        "title": "Script",
        "type": "object"
      }
    },

    "properties": {
      "script": {
        "default": [],
        "description": "Scripts to execute",
        "items": {
          "$ref": "#/$defs/Script"
        },
        "title": "Scripts",
        "type": "array"
      },

      "cron": {
        "default": "10 min",
        "description": "Cron Interval",
        "title": "Cron",
        "type": "string"
      },
      "desc": {
        "default": "News post: {title}{err}",
        "description": "Description Template",
        "title": "Description",
        "type": "string"
      },
      "err_always": {
        "default": true,
        "description": "Always Alert on Error",
        "title": "Track Error (always)",
        "type": "boolean"
      },
      "feeds": {
        "default": "https://cointelegraph.com/rss",
        "description": "Feeds URI",
        "title": "Feeds",
        "type": "string"
      },
      
      "max": {
        "default": 10,
        "description": "Max news",
        "title": "Max",
        "type": "number"
      },
      "score": {
        "default": "",
        "description": "Score ",
        "title": "Score condition",
        "type": "string"
      },
      "severity": {
        "default": -1,
        "description": "Severity",
        "title": "Severity",
        "type": "number"
      },
      "track_err": {
        "default": true,
        "description": "Track Errors as Alerts",
        "title": "Track Errors",
        "type": "boolean"
      },
      "type": {
        "default": "rss",
        "description": "Feed Type",
        "title": "Feed type",
        "type": "string"
      }
    },
    "required": ["feeds", "type", "cron"],
    "title": "Schema",
    "type": "object"
  },
  "status": "ACTIVE",
  "tags": ["SECURITY", "COMPLIANCE", "beta", "FINANCIAL"],
  "title": "News",
  "uiSchema": {
    "ui:order": ["cron", "desc", "feeds", "type", "max", "score", "script", "track_err", "err_always", "severity"]
