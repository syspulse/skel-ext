{
  "author": "Hacken",
  "createdAt": 1765725481270,
  "description": "Detector monitors news feeds",
  "faq": [
    {
      "name": "How does it work",
      "value": "Track news from different feeds"
    },
    {
      "name": "Feed",
      "value": "Feeds URI\n\nMulitple URI's can be specified with comma separation. If `type` is not specified, feed can be prefixed with type (`rss://`. `reddit://`)\n"
    }, 
    {
      "name": "Cron",
      "value": "Cron interval to check for new posts. Refer to [Cron](https://docs.extractor.live/common-configurations#cron) for more details"
    },
    {
      "name": "Type",
      "value": "Type of news:\n- `rss`\n- `reddit`"
    },
    {
      "name": "Max",
      "value": "Max number of entries per Feed"
    },  
    {
      "name": "Category",
      "value": "Message Category filter (comma separated list of categories). If not specified, all messages will be processed."
    },
    {
      "name": "Scripts",
      "value": "Scripts to execute\n\nScripts are executed in the order they are specified. Refer to [Scripts](https://docs.extractor.live/common-configurations#condition-threshold) for more details.\n\nScripts execution result will be in `result` meta field.\n"
    },    
    {
      "name": "Score",
      "value": "Condition to filter Alerts score on `result` (result must be in the range: [0..1]). Refer to [Condition](https://docs.extractor.live/common-configurations#condition) for more details"
    },     
    {
      "name": "Track Error",
      "value": "Track Errors\n\nMuliple tags can be specified comma-separated (e.g. `sanctions, exploit`)\n\nNegative condition can be specified by prefixing tag with exclamation mark (e.g. `! sanctions`)\n\n__Tags__:\n\n`cybercrime` - OFAC or othe cybercrime activity\n\n`sanctions` - OFAC or other sanctioned entites\n\n`sanctions_exposure` - Indirect exposure to sanctioned entities\n\n`suspicious` - Suspcious activity\n\n`exploit` - Activity in Exploit case\n"
    },
    {
      "name": "Track Error Always",
      "value": "Track Errors Always\n\nIf enabled, the detector will track errors even if the script result is not a score."
    },
    {
      "name": "Severity",
      "value": "Severity of the Alert. If not specified, the detector will use the severity of the script result."
    },
    {
      "name": "Description",
      "value": "Description template for the Alert description. Can use any meta field as placeholder (e.g. `{title}`)"
    }
  ],
  "icon": "https://cdn-icons-png.flaticon.com/512/3536/3536964.png",
  "id": 446,
  "name": "DetectorNews",
  "networkTags": [],
  "schema": {
    "$defs": {
      "Script": {
        "properties": {
          "type": {
            "description": "Script Type",
            "title": "Type",
            "type": "string",
            "enum": ["regexp","filter","sq","jq","js", "ai","regexp_score","sq_score","jq_score","condition"],
            "default": "js"
          },
          "src": {
            "description": "Script Source",
            "title": "Source",
            "default": "",
            "type": "string"
          },
          "options": {
            "description": "Script Options",
            "title": "Options",
            "default": "",
            "type": "string"
          }
        },
        "required": ["type"],
        "title": "Script",
        "type": "object"
      }
    },

    "properties": {
      "script": {
        "default": [],
        "description": "Scripts to execute",
        "items": {
          "$ref": "#/$defs/Script"
        },
        "title": "Scripts",
        "type": "array"
      },

      "cron": {
        "default": "10 min",
        "description": "Cron Interval",
        "title": "Cron",
        "type": "string"
      },
      "desc": {
        "default": "{title} {err}",
        "description": "Description Template",
        "title": "Description",
        "type": "string"
      },
      "err_always": {
        "default": true,
        "description": "Always Alert on Error",
        "title": "Track Error (always)",
        "type": "boolean"
      },
      "feeds": {
        "default": "https://cointelegraph.com/rss",
        "description": "Feeds URI",
        "title": "Feeds",
        "type": "string"
      },
      "category": {
        "default": "",
        "description": "Category filter",
        "title": "Category",
        "type": "string"
      },
      "max": {
        "default": 10,
        "description": "Max news",
        "title": "Max",
        "type": "number"
      },
      "score": {
        "default": "",
        "description": "Score ",
        "title": "Score condition",
        "type": "string"
      },
      "severity": {
        "default": -1,
        "description": "Severity",
        "title": "Severity",
        "type": "number"
      },
      "track_err": {
        "default": true,
        "description": "Track Errors as Alerts",
        "title": "Track Errors",
        "type": "boolean"
      },
      "type": {
        "default": "rss",
        "description": "Feed Type",
        "title": "Feed type",
        "type": "string",
        "enum": ["rss","atom","reddit","twitter","meltwater"]
      },
      "event_sid": {
        "default": "",
        "description": "Internal Source ID",
        "title": "Event Source ID",
        "type": "string"
      },
      "event_cat": {
        "default": "",
        "description": "Internal Event Category",
        "title": "Event Category",
        "type": "string"
      },
      "event_type": {
        "default": "",
        "description": "Internal Event Type",
        "title": "Event Type",
        "type": "string"
      },
      "timeout": {
        "default": 10000,
        "description": "Timeout",
        "title": "Timeout",
        "type": "number"
      },
      "delay": {
        "default": 1000,
        "description": "Delay",
        "title": "Delay",
        "type": "number"
      }
    },
    "required": ["feeds", "type", "cron"],
    "title": "Schema",
    "type": "object"
  },
  "status": "ACTIVE",
  "tags": ["SECURITY", "COMPLIANCE", "beta", "FINANCIAL","web2"],
  "title": "News",
  "uiSchema": {
    "script": {
        "items": {
            "src": {
                "ui:options": {
                    "rows": 5,
                    "widget": "textarea"
                }
            }            
        }
    },
    "ui:order": ["cron", "feeds", "type", "max", "category", "score", "script", "track_err", "err_always", "desc", "event_type","event_cat", "event_sid", "timeout", "delay", "severity"]
  },
  "updatedAt": 1765725481270,
  "version": "0.0.11"
}
